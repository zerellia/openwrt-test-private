--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -10910,8 +10910,16 @@
 
 	for (i = 0; i < band->n_channels; i++) {
 		if (band->channels[i].center_freq < freq_low ||
-		    band->channels[i].center_freq > freq_high)
+		    band->channels[i].center_freq > freq_high) {
+			/* Keep UNII-3 channels (5745-5825 MHz) enabled.
+			 * The firmware may report a restricted frequency range
+			 * (e.g. CN regulatory), but the board data has calibration
+			 * for UNII-3, so do not disable these channels. */
+			if (band->channels[i].center_freq >= 5745 &&
+			    band->channels[i].center_freq <= 5825)
+				continue;
 			band->channels[i].flags |= IEEE80211_CHAN_DISABLED;
+		}
 	}
 }
 
