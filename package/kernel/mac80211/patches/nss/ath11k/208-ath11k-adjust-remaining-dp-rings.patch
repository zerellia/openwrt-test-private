From: mufeng05 (proper hunk calculation)
Subject: ath11k: adjust remaining DP rings for 256M boards

Complement to 207's 256M profile. Changes three rings not covered by 207:
- DP_RX_RELEASE_RING_SIZE: 1024 -> 4096 (NSS stability)
- DP_RXDMA_BUF_RING_SIZE: 4096 -> 1024 (RAM)
- DP_RXDMA_MONITOR_DESC_RING_SIZE: 4096 -> 128 (RAM)

Applied after 207, so line numbers account for 207's +1 shift.

---
 drivers/net/wireless/ath/ath11k/dp.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/dp.h b/drivers/net/wireless/ath/ath11k/dp.h
index 1234567..89abcde 100644
--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -214,7 +214,7 @@ struct ath11k_pdev_dp {
 #define DP_REO_DST_RING_SIZE		2048
 #define DP_REO_REINJECT_RING_SIZE	32
-#define DP_RX_RELEASE_RING_SIZE		1024
+#define DP_RX_RELEASE_RING_SIZE		4096
 #define DP_REO_EXCEPTION_RING_SIZE	128
 #define DP_REO_CMD_RING_SIZE		256
 #define DP_REO_STATUS_RING_SIZE		2048
@@ -222,9 +222,9 @@ struct ath11k_pdev_dp {
-#define DP_RXDMA_BUF_RING_SIZE		4096
+#define DP_RXDMA_BUF_RING_SIZE	1024
 #define DP_RXDMA_REFILL_RING_SIZE	2048
 #define DP_RXDMA_ERR_DST_RING_SIZE	1024
 #define DP_RXDMA_MON_STATUS_RING_SIZE	ATH11K_DP_RXDMA_MON_STATUS_RING_SIZE
 #define DP_RXDMA_MONITOR_BUF_RING_SIZE	ATH11K_DP_RXDMA_MONITOR_BUF_RING_SIZE
 #define DP_RXDMA_MONITOR_DST_RING_SIZE	ATH11K_DP_RXDMA_MONITOR_BUF_RING_SIZE
-#define DP_RXDMA_MONITOR_DESC_RING_SIZE	4096
+#define DP_RXDMA_MONITOR_DESC_RING_SIZE	128
 
 #define DP_RX_RELEASE_RING_NUM	3
 
